# ==============================================================================
# ListenFlow — Environment Configuration Template
# ==============================================================================
# ListenFlow is designed as a secure, local-first client-side web application.
# It does not require any custom backend server or database connection.
#
# IMPORTANT SECURITY NOTICE:
# - Do NOT store sensitive private keys, database credentials, or secret API
#   tokens in this file or any .env file in Vite.
# - Any variable prefixed with `VITE_` will be statically compiled into the
#   public client JavaScript bundle and exposed to all visitors.
# ==============================================================================

# Application environment mode (development, production)
# NODE_ENV=development

# Optional public configuration (Vite exposes VITE_* to the browser)
# VITE_APP_TITLE="ListenFlow — Luyện nghe & Chép chính tả YouTube"
